<?xml version="1.0" encoding="utf-8"?>
<!--
  Collapsed notification layout — MusicXMatch style.
  Uses transparent background so the OS draws its own notification surface.
  No custom card/rounded container — blends naturally with the system shade.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_collapsed_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingTop="6dp"
    android:paddingEnd="4dp"
    android:paddingBottom="6dp">

    <!-- Album Art — rounded, compact -->
    <ImageView
        android:id="@+id/notif_collapsed_art"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:background="@drawable/bg_album_art_rounded"
        android:contentDescription="Album Art"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_lyrics_notification" />

    <!-- Content: Song title, artist, current lyric -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="4dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Song title — bold, prominent -->
        <TextView
            android:id="@+id/notif_collapsed_track_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Lyrica Live"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Current lyric line — muted, smaller -->
        <TextView
            android:id="@+id/notif_collapsed_active_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="♪ Waiting for music…"
            android:textColor="#B0B0B0"
            android:textSize="12sp" />

    </LinearLayout>

</LinearLayout>
