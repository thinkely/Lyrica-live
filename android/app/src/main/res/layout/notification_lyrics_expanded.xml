<?xml version="1.0" encoding="utf-8"?>
<!--
  Expanded notification layout — MusicXMatch style.
  Transparent background: OS draws its own surface.
  Structure:
    1. Header row: album art + song title/artist
    2. Lyrics section: bold active line + cascading faded upcoming lines
    3. Source badge at bottom
  No transport controls (OS media player handles that), no custom dark card.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_expanded_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingTop="6dp"
    android:paddingEnd="4dp"
    android:paddingBottom="8dp">

    <!-- ── Header: Album Art + Track Info ────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Album Art -->
        <ImageView
            android:id="@+id/notif_expanded_art"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_album_art_rounded"
            android:contentDescription="Album Art"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_lyrics_notification" />

        <!-- Title & Artist column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Song title — bold white -->
            <TextView
                android:id="@+id/notif_expanded_track_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Karan Aujla — 7.7 Magnitude"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Source badge — subtle, bottom of header -->
            <TextView
                android:id="@+id/notif_mode_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="LRCLIB"
                android:textColor="#888888"
                android:textSize="10sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

    <!-- ── Lyrics Section ─────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical">

        <!-- Previous line — faintest, smallest -->
        <TextView
            android:id="@+id/notif_expanded_line_prev"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text=""
            android:textColor="#666666"
            android:textSize="12sp" />

        <!-- ── ACTIVE LINE: Bold, large, bright white ── -->
        <TextView
            android:id="@+id/notif_expanded_line_curr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="♪ Waiting for music…"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Next line 1 — slightly muted -->
        <TextView
            android:id="@+id/notif_expanded_line_next1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text=""
            android:textColor="#AAAAAA"
            android:textSize="13sp" />

        <!-- Next line 2 — more muted -->
        <TextView
            android:id="@+id/notif_expanded_line_next2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text=""
            android:textColor="#888888"
            android:textSize="12sp" />

        <!-- Next line 3 — faintest -->
        <TextView
            android:id="@+id/notif_expanded_line_next3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text=""
            android:textColor="#666666"
            android:textSize="11.5sp" />

        <!-- Next line 4 — barely visible -->
        <TextView
            android:id="@+id/notif_expanded_line_next4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text=""
            android:textColor="#555555"
            android:textSize="11sp" />

    </LinearLayout>

</LinearLayout>
