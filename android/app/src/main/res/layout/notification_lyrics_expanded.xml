<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_expanded_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_notification_card"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <!-- 3-line lyrics container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Previous Line -->
        <TextView
            android:id="@+id/notif_expanded_prev_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text=""
            android:textColor="#8E8E93"
            android:textSize="12sp" />

        <!-- Current Active Line (Apple Red) -->
        <TextView
            android:id="@+id/notif_expanded_current_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="♪ Searching for lyrics…"
            android:textColor="#FA233B"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Next Line -->
        <TextView
            android:id="@+id/notif_expanded_next_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text=""
            android:textColor="#8E8E93"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="#E5E5EA" />

    <!-- Actions Row: Prev | Play/Pause | Next | Mode indicator -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Prev Line Action -->
        <TextView
            android:id="@+id/notif_btn_prev"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="10dp"
            android:text="← Prev"
            android:textColor="#FA233B"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Play / Pause Action -->
        <TextView
            android:id="@+id/notif_btn_play_pause"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="Pause"
            android:textColor="#1C1C1E"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Next Line Action -->
        <TextView
            android:id="@+id/notif_btn_next"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="Next →"
            android:textColor="#FA233B"
            android:textSize="12sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Translation / Romanization Mode Label -->
        <TextView
            android:id="@+id/notif_mode_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:text="Original"
            android:textColor="#8E8E93"
            android:textSize="10sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
